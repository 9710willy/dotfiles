{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash

# Codex provider: {{ .codex.provider }}
# Installer revision: 2
# yeon runs several commands, filters their output in JavaScript, and returns one
# compact value. The package lives in a private repo, so npm needs a GitHub
# credential that can read 9710willy/yeon.

set -euo pipefail

# mise reshim puts a shim in front of the global bin directory, so the shim can
# outlive the binary it dispatches to. Run yeon before trusting it.
if command -v yeon >/dev/null 2>&1 && yeon --help >/dev/null 2>&1; then
  echo "yeon is already installed"
  exit 0
fi

command -v node >/dev/null 2>&1 || { echo "node is required for yeon" >&2; exit 1; }
command -v npm >/dev/null 2>&1 || { echo "npm is required for yeon" >&2; exit 1; }

node_major="$(node -p 'process.versions.node.split(".")[0]')"
if (( node_major < 20 )); then
  echo "yeon needs Node.js 20 or later, found $(node -v)" >&2
  exit 1
fi

npm install --global github:9710willy/yeon >/dev/null

echo "Installed yeon from 9710willy/yeon"
{{ end -}}
