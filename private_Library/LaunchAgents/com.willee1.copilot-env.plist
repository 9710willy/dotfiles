<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.willee1.copilot-env</string>
    <!-- Re-publishes COPILOT_API_KEY into the launchd user environment at login.
         launchctl setenv does not survive a reboot; without this agent the env
         var silently disappears after a restart and anything reading it (codex
         env_key, ad-hoc scripts) breaks. The key is read from config.json
         (mode 0600) at run time so no secret is stored in this plist. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>key="$(/opt/homebrew/bin/node -e 'const k = require("/Users/willee1/.local/share/copilot-api/config.json").auth.apiKeys[0]; if (typeof k !== "string" || k.length &lt; 32) { console.error("no usable apiKeys[0] in config.json"); process.exit(1); } process.stdout.write(k)')" &amp;&amp; /bin/launchctl setenv COPILOT_API_KEY "$key" &amp;&amp; echo "$(date '+%Y-%m-%dT%H:%M:%S') COPILOT_API_KEY published to launchd env"</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/willee1/Library/Logs/copilot-env.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/willee1/Library/Logs/copilot-env.log</string>
</dict>
</plist>
