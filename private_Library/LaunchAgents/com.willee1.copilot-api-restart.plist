<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.willee1.copilot-api-restart</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/willee1/.local/share/copilot-api/daily-maintenance.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/willee1/Library/Logs/copilot-api-restart.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/willee1/Library/Logs/copilot-api-restart.log</string>
    <!-- PATH must include /opt/homebrew/bin: daily-maintenance.sh's patch-guard
         job calls reapply-patches.sh, which needs node. Under launchd's default
         PATH the reapply always failed with 127 and the service restarted
         unpatched after an npm upgrade. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
