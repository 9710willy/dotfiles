[user]
	name = {{ .git.name }}
	email = {{ .git.email }}
{{- if and .git.signingKey (ne .git.signingKey "none") }}
	signingkey = {{ .git.signingKey }}
[commit]
	gpgsign = true
{{- else }}
[commit]
	gpgsign = false
{{- end }}

[alias]
	st = status -sb
	co = checkout
	cb = checkout -b
	cm = commit -m
	ca = commit --amend
	can = commit --amend --no-edit
	unstage = reset HEAD --
	last = log -1 HEAD --stat
	lg = log --oneline --graph --decorate -20
	br = branch -vv
	df = diff
	dfs = diff --staged
	p = push
	pf = push --force-with-lease
	pl = pull --rebase
	undo = reset --soft HEAD~1
	stash-all = stash push --include-untracked

[core]
	pager = delta
	fsmonitor = true

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = true
	syntax-theme = gruvbox-dark

[merge]
	# zdiff3 = diff3 but with common lines at the hunk edges factored out
	conflictstyle = zdiff3

[init]
	defaultBranch = main

[diff]
	colorMoved = default

[feature]
	manyFiles = true

[credential]
	helper = osxkeychain
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rerere]
	enabled = true
