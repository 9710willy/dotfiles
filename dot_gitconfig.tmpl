[user]
	name = {{ .git.name }}
	email = {{ .git.email }}
{{- if and .git.signingKey (ne .git.signingKey "none") }}
	signingkey = {{ .git.signingKey }}
[commit]
	gpgsign = true
{{- else }}
[commit]
	gpgsign = false
{{- end }}

[alias]
	st = status -sb
	co = checkout
	cb = checkout -b
	cm = commit -m
	ca = commit --amend
	can = commit --amend --no-edit
	unstage = reset HEAD --
	last = log -1 HEAD --stat
	lg = log --oneline --graph --decorate -20
	br = branch -vv
	df = diff
	dfs = diff --staged
	p = push
	pf = push --force-with-lease
	pl = pull --rebase
	undo = reset --soft HEAD~1
	stash-all = stash push --include-untracked

[core]
	pager = delta
	fsmonitor = true
	# fsmonitor only pays off with untrackedCache: without it, git still walks
	# the worktree to find untracked files on every status.
	untrackedCache = true
	commitGraph = true
	# APFS hands back NFD filenames; without this, accented paths look modified.
	precomposeUnicode = true
	# Time Machine and Spotlight touch ctime, which git would read as a change.
	trustctime = false

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = true
	syntax-theme = gruvbox-dark

[merge]
	# zdiff3 = diff3 but with common lines at the hunk edges factored out
	conflictstyle = zdiff3

[init]
	defaultBranch = main

[diff]
	colorMoved = default
	# histogram gives cleaner hunks than the default myers, which matters most
	# when a human or a model is reading the diff to review a change.
	algorithm = histogram
	renames = copies
	# a/ b/ prefixes become i/ w/ c/ so you can tell index from worktree
	mnemonicPrefix = true
	wsErrorHighlight = all

[feature]
	manyFiles = true

[credential]
	helper = osxkeychain
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
	writeCommitGraph = true
[rerere]
	enabled = true

# --- Performance: 12-core M3 Pro, so let git use the cores it has ---
[index]
	version = 4
	threads = 0
[pack]
	threads = 0
[checkout]
	# parallel checkout, a large win on branch switches in big repos
	workers = 0
[maintenance]
	auto = true
	strategy = incremental

# --- Rebase and history quality of life ---
[rebase]
	autosquash = true
	autostash = true
	# keep stacked branches pointing at the right commits after a rebase
	updateRefs = true
[branch]
	sort = -committerdate
[tag]
	sort = -version:refname
[log]
	date = iso
[submodule]
	recurse = true
[transfer]
	fsckobjects = true
[help]
	autocorrect = prompt
