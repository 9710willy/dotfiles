# Brewfile - managed by chezmoi
# Machine context: {{ .machine.context }}

# =============================================================================
# Core Tools (all machines)
# =============================================================================
brew "chezmoi"
brew "neovim"
brew "tmux"

# Shell enhancements
brew "bat"
brew "direnv"
brew "eza"
brew "fzf"
brew "lazygit"
brew "mise"
brew "tlrc"
brew "zoxide"
brew "git-delta"

# Search & navigation
brew "ripgrep"
brew "fd"
brew "ast-grep"  # structural (syntax-aware) search and rewrite, not regex

# Useful CLI tools
brew "gh"        # GitHub CLI
brew "jq"        # JSON processor
brew "yq"        # YAML/TOML processor, jq syntax
brew "difftastic"  # structural diff; `difft` reads far better than line diffs
brew "hyperfine" # benchmark shell commands with real statistics
brew "tokei"     # count lines of code per language
brew "sd"        # find and replace, saner syntax than sed
brew "ruff"      # Python lint + format, one fast binary

# =============================================================================
# Development Tools (all machines)
# =============================================================================

# Language servers & formatters
brew "lua-language-server"
brew "prettierd"
brew "selene"
brew "yaml-language-server"

# Docker
brew "colima"
brew "docker"

# CLI utilities & dev tooling
brew "btop"
brew "ffmpeg"
brew "git-filter-repo"
brew "go"
brew "p7zip"     # 7z used by zshrc extract()
brew "pinentry-mac"
brew "pkgconf"
brew "plantuml"
brew "poppler"
brew "shellcheck"
brew "shfmt"
brew "stylua"
brew "swaks"
brew "tree-sitter-cli"  # parser auto-install for the nvim-treesitter rewrite
brew "uv"        # Python tool runner + installer (replaces pipx)
brew "yt-dlp"

# =============================================================================
# GUI Apps (all machines)
# =============================================================================
cask "ghostty"
cask "codex"
cask "font-jetbrains-mono-nerd-font"  # ghostty font-family depends on this
cask "karabiner-elements"
cask "raycast"
cask "rectangle"

{{- if eq .machine.context "company" }}

# =============================================================================
# Company machine tools
# =============================================================================
brew "ant"
brew "glab"
brew "gradle@7"
brew "mysql"
brew "nginx"
brew "pam-u2f"
brew "ykman"
{{- if eq .codex.provider "copilot" }}
brew "sleepwatcher"
{{- end }}
cask "firefox"
cask "gcloud-cli"
cask "kiwix"
cask "libreoffice"
cask "mysqlworkbench"

{{- end }}

{{- if eq .machine.context "personal" }}

# =============================================================================
# Personal machine tools
# =============================================================================

# Uncomment as needed:
# cask "figma"
# cask "notion"
# brew "postgresql@16"
# brew "redis"

{{- end }}
