#!/usr/bin/env bash
# jira — minimal-output Jira Cloud v3 wrapper (token-efficient for LLM use)
# Env: ATLASSIAN_EMAIL, ATLASSIAN_TOKEN, ATLASSIAN_SITE (export from your shell profile)
set -euo pipefail

command -v jq >/dev/null || { echo "jira: requires jq (brew install jq)" >&2; exit 1; }
: "${ATLASSIAN_EMAIL:?not set — export your Atlassian login email in your shell profile}"
: "${ATLASSIAN_TOKEN:?not set — create a token at https://id.atlassian.com/manage-profile/security/api-tokens and export it in your shell profile}"
: "${ATLASSIAN_SITE:?not set — export your Atlassian site subdomain (SITE in https://SITE.atlassian.net) in your shell profile}"
JIRA_BASE="https://${ATLASSIAN_SITE}.atlassian.net/rest/api/3"

AUTH="Authorization: Basic $(printf '%s:%s' "$ATLASSIAN_EMAIL" "$ATLASSIAN_TOKEN" | base64)"

req() { # req METHOD PATH [curl-args...] — errors to stderr, one Retry-After-aware 429 retry
  local method="$1" path="$2"; shift 2
  local out code hdrs retried=0
  while :; do
    hdrs=$(mktemp)
    out=$(curl -sS -D "$hdrs" -w '\n%{http_code}' -X "$method" -H "$AUTH" "$JIRA_BASE$path" "$@")
    code="${out##*$'\n'}"; out="${out%$'\n'*}"
    if [[ "$code" == 429 && "$retried" == 0 ]]; then
      retried=1
      sleep "$(awk 'tolower($1)=="retry-after:"{print int($2); f=1} END{if(!f)print 5}' "$hdrs")"
      rm -f "$hdrs"; continue
    fi
    rm -f "$hdrs"; break
  done
  if [[ "$code" -ge 300 ]]; then
    echo "HTTP $code" >&2
    echo "$out" | jq -r '.errorMessages[]?, (.errors // {} | to_entries[] | "\(.key): \(.value)")' >&2 2>/dev/null || echo "$out" >&2
    exit 1
  fi
  printf '%s' "$out"
}

striphtml() {
  sed -e 's/<br[^>]*>/\n/g; s/<\/p>/\n/g; s/<\/li>/\n/g; s/<\/h[1-6]>/\n/g; s/<\/tr>/\n/g; s/<\/div>/\n/g' \
      -e 's/<[^>]*>/ /g' -e 's/&nbsp;/ /g; s/&amp;/\&/g; s/&lt;/</g; s/&gt;/>/g; s/&quot;/"/g; s/&#39;/'"'"'/g' \
    | awk '{$1=$1};NF'
}

adf() { # plain text -> ADF doc JSON (blank line=paragraph; "- " lines=bullet list; "Label:"=bold; `code`=inline code; --- =rule)
  python3 "$(dirname "$0")/jira-adf.py" <<<"$1"
}

MAXL="${ATLASSIAN_MAX_LINES:-200}"   # 0 = unlimited
cap() { # cap HINT — print first $MAXL lines of stdin, then say what was dropped
  local hint="$1"
  if [[ "$MAXL" == 0 ]]; then cat; return 0; fi
  awk -v n="$MAXL" -v hint="$hint" '
    NR<=n { print; next }
    END { if (NR>n) printf "\n[truncated - showed %d of %d lines]\n[rest: %s | sed -n %d,%dp]\n", n, NR, hint, n+1, NR }'
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  get) # jira get KEY [extra,fields]
    key="$1"; extra="${2:+,$2}"
    out=$(req GET "/issue/$key?fields=summary,status,assignee,priority,issuetype,parent,labels,description${extra:-}&expand=renderedFields")
    jq -r '"\(.key)  [\(.fields.issuetype.name)] \(.fields.status.name)  \(.fields.priority.name // "-")  @\(.fields.assignee.displayName // "unassigned")",
           "parent: \(.fields.parent.key // "-")  labels: \(.fields.labels | join(","))",
           "summary: \(.fields.summary)",
           (.fields | del(.summary,.status,.assignee,.priority,.issuetype,.parent,.labels,.description) | to_entries[] | select(.value != null) | "\(.key): \(.value | tostring | .[0:200])"),
           "--- description ---"' <<<"$out"
    jq -r '.renderedFields.description // ""' <<<"$out" | striphtml | cap "ATLASSIAN_MAX_LINES=0 jira get $key" ;;
  search) # jira search 'JQL' [maxResults] [extra,fields] — JQL must be bounded
    jql="$1"; max="${2:-50}"; extra="${3:+,$3}"
    req GET "/search/jql" -G --data-urlencode "jql=$jql" \
      --data-urlencode "fields=summary,status,assignee${extra:-}" --data-urlencode "maxResults=$max" \
      | jq -r '(.issues[] | "\(.key)\t\(.fields.status.name)\t\(.fields.assignee.displayName // "-")\t\(.fields.summary)"),
               (if .nextPageToken then "nextPageToken: \(.nextPageToken)" else empty end)' ;;
  count) # jira count 'JQL'
    req POST "/search/approximate-count" -H 'Content-Type: application/json' \
      -d "$(jq -n --arg jql "$1" '{jql:$jql}')" | jq -r '.count' ;;
  comments) # jira comments KEY [limit]
    req GET "/issue/$1/comment?orderBy=-created&maxResults=${2:-20}&expand=renderedBody" \
      | jq -r '.comments[] | "[\(.created[0:16]) \(.author.displayName)]\n\(.renderedBody)\n<hr>"' | striphtml \
      | cap "ATLASSIAN_MAX_LINES=0 jira comments $1" ;;
  comment) # jira comment KEY 'text'
    req POST "/issue/$1/comment" -H 'Content-Type: application/json' \
      -d "$(jq -n --argjson body "$(adf "$2")" '{body:$body}')" | jq -r '"comment \(.id) added"' ;;
  create) # jira create PROJ Type 'summary' ['description'] ['{"extra":"fields"}' — merged in, for issue types with more required create-screen fields]
    req POST "/issue" -H 'Content-Type: application/json' \
      -d "$(jq -n --arg p "$1" --arg t "$2" --arg s "$3" --argjson d "$(adf "${4:-}")" --argjson x "${5:-{\}}" \
        '{fields:(({project:{key:$p},issuetype:{name:$t},summary:$s,description:$d}) * $x)}')" | jq -r '.key' ;;
  update) # jira update KEY '{"summary":"..."}'  (raw fields JSON)
    req PUT "/issue/$1" -H 'Content-Type: application/json' \
      -d "$(jq -n --argjson f "$2" '{fields:$f}')" >/dev/null && echo "updated $1" ;;
  transitions) # jira transitions KEY
    req GET "/issue/$1/transitions" | jq -r '.transitions[] | "\(.id)\t\(.name)\t-> \(.to.name)"' ;;
  transition) # jira transition KEY ID
    req POST "/issue/$1/transitions" -H 'Content-Type: application/json' \
      -d "{\"transition\":{\"id\":\"$2\"}}" >/dev/null && echo "transitioned $1" ;;
  user) # jira user QUERY — find accountId for JQL/payloads
    req GET "/user/search" -G --data-urlencode "query=$1" \
      | jq -r '.[] | "\(.accountId)\t\(.displayName)\t\(.emailAddress // "-")"' ;;
  raw) # jira raw METHOD /path [curl-args...] — escape hatch, full JSON out
    m="$1"; p="$2"; shift 2; req "$m" "$p" "$@" | jq . ;;
  *)
    grep -E '^  [a-z|]+\)' "$0" | sed 's/) # /  /;s/^ *//' ;;
esac
