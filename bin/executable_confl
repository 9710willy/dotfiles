#!/usr/bin/env bash
# confl — minimal-output Confluence Cloud wrapper (token-efficient for LLM use)
# Env: ATLASSIAN_EMAIL, ATLASSIAN_TOKEN, ATLASSIAN_SITE (export from your shell profile)
set -euo pipefail

command -v jq >/dev/null || { echo "confl: requires jq (brew install jq)" >&2; exit 1; }
: "${ATLASSIAN_EMAIL:?not set — export your Atlassian login email in your shell profile}"
: "${ATLASSIAN_TOKEN:?not set — create a token at https://id.atlassian.com/manage-profile/security/api-tokens and export it in your shell profile}"

: "${ATLASSIAN_SITE:?not set — export your Atlassian site subdomain (SITE in https://SITE.atlassian.net) in your shell profile}"
V2="https://${ATLASSIAN_SITE}.atlassian.net/wiki/api/v2"
V1="https://${ATLASSIAN_SITE}.atlassian.net/wiki/rest/api"
AUTH="Authorization: Basic $(printf '%s:%s' "$ATLASSIAN_EMAIL" "$ATLASSIAN_TOKEN" | base64)"

req() { # req METHOD URL [curl-args...] — one Retry-After-aware 429 retry
  local method="$1" url="$2"; shift 2
  local out code hdrs retried=0
  while :; do
    hdrs=$(mktemp)
    out=$(curl -sS -D "$hdrs" -w '\n%{http_code}' -X "$method" -H "$AUTH" "$url" "$@")
    code="${out##*$'\n'}"; out="${out%$'\n'*}"
    if [[ "$code" == 429 && "$retried" == 0 ]]; then
      retried=1
      sleep "$(awk 'tolower($1)=="retry-after:"{print int($2); f=1} END{if(!f)print 5}' "$hdrs")"
      rm -f "$hdrs"; continue
    fi
    rm -f "$hdrs"; break
  done
  if [[ "$code" -ge 300 ]]; then
    echo "HTTP $code" >&2; echo "$out" >&2; exit 1
  fi
  printf '%s' "$out"
}

HMARK=$'\001'                        # heading sentinel, injected before tags are stripped
MAXL="${ATLASSIAN_MAX_LINES:-200}"   # 0 = unlimited
cap() { # cap HINT — heading outline + first $MAXL lines; always removes the sentinel
  local hint="$1"
  awk -v n="$MAXL" -v hint="$hint" -v M="$HMARK" '
    { l[NR] = $0 }
    END {
      cut = (n > 0 && NR > n)
      if (cut) {
        for (i = 1; i <= NR; i++) if (index(l[i], M) == 1) { hn[++nh] = i; ht[nh] = substr(l[i], 2) }
        if (nh) {
          printf "--- outline (%d lines total) ---\n", NR
          for (j = 1; j <= nh; j++) printf "%6d  %s\n", hn[j], ht[j]
          printf "--- body (lines 1-%d) ---\n", n
        }
      }
      lim = cut ? n : NR
      for (i = 1; i <= lim; i++) { s = l[i]; sub("^" M, "", s); print s }
      if (cut) printf "\n[truncated - showed %d of %d lines]\n[rest: %s | sed -n %d,%dp]\n", n, NR, hint, n + 1, NR
    }'
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  get) # confl get PAGEID — title/meta + body as readable text
    req GET "$V2/pages/$1?body-format=export_view" \
      | jq -r '"id: \(.id)  v\(.version.number)  space: \(.spaceId)  parent: \(.parentId // "-")",
               "title: \(.title)", "---", .body.export_view.value' \
      | sed -e 's/<h[1-6][^>]*>/\n'"$HMARK"'/g' \
            -e 's/<br[^>]*>/\n/g; s/<\/p>/\n/g; s/<\/li>/\n/g; s/<\/h[1-6]>/\n/g; s/<\/tr>/\n/g; s/<\/div>/\n/g' \
            -e 's/<[^>]*>/ /g' -e 's/&nbsp;/ /g; s/&amp;/\&/g; s/&lt;/</g; s/&gt;/>/g; s/&quot;/"/g' \
      | awk '{$1=$1};NF' \
      | cap "ATLASSIAN_MAX_LINES=0 confl get $1" ;;
  body) # confl body PAGEID — raw storage-format HTML (for edits; never capped, a cut body corrupts update)
    req GET "$V2/pages/$1?body-format=storage" | jq -r '.body.storage.value' ;;
  search) # confl search 'CQL' [limit]
    req GET "$V1/search" -G --data-urlencode "cql=$1" --data-urlencode "limit=${2:-25}" \
      | jq -r '(.results[] | "\(.content.id // .id)\t\(.content.type // .entityType)\t\(.title // .content.title)"),
               (if ._links.next then "next: \(._links.next)" else empty end)' ;;
  create) # confl create SPACEID 'title' [PARENTID] < body.html  (storage HTML on stdin)
    body=$(cat)
    req POST "$V2/pages" -H 'Content-Type: application/json' \
      -d "$(jq -n --arg s "$1" --arg t "$2" --arg p "${3:-}" --arg b "$body" \
        '{spaceId:$s,title:$t,body:{representation:"storage",value:$b}} + (if $p != "" then {parentId:$p} else {} end)')" \
      | jq -r '"created \(.id): \(._links.base // "")\(._links.webui // "")"' ;;
  update) # confl update PAGEID 'title' < body.html  (auto version bump)
    body=$(cat)
    v=$(req GET "$V2/pages/$1" | jq -r '.version.number')
    req PUT "$V2/pages/$1" -H 'Content-Type: application/json' \
      -d "$(jq -n --arg id "$1" --arg t "$2" --arg b "$body" --argjson v "$((v + 1))" \
        '{id:$id,status:"current",title:$t,body:{representation:"storage",value:$b},version:{number:$v}}')" >/dev/null \
      && echo "updated $1 -> v$((v + 1))" ;;
  children) # confl children PAGEID
    req GET "$V2/pages/$1/direct-children?limit=100" | jq -r '.results[] | "\(.id)\t\(.title)"' ;;
  raw) # confl raw METHOD URL-PATH(v2-relative or full URL) [curl-args...]
    m="$1"; p="$2"; shift 2
    [[ "$p" == http* ]] || p="$V2$p"
    req "$m" "$p" "$@" | jq . ;;
  *)
    grep -E '^  [a-z|]+\)' "$0" | sed 's/) # /  /;s/^ *//' ;;
esac
